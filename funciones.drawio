="estado[i] == estadoBuscado &amp;amp;&amp;amp;&lt;br&gt;strcasecmp(nombres[i], nombre) == 0" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1307" y="32560" width="390" height="80" as="geometry"/></mxCell><mxCell id="n_f15_BG" value="indice = i" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="879" y="32712" width="130" height="44" as="geometry"/></mxCell><mxCell id="n_f15_BI" value="indice == -1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="859" y="32828" width="170" height="80" as="geometry"/></mxCell><mxCell id="n_f15_BH" value="i++" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1476" y="32712" width="130" height="44" as="geometry"/></mxCell><mxCell id="n_f15_BJ" value="printf(&quot;No se encontro ningun plan de credito con ese nombre en&lt;br&gt;ese estado\n\n&quot;)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="683" y="32978" width="486" height="56" as="geometry"/></mxCell><mxCell id="n_f15_CA" value="int conf = validarEnteroRango(&quot;Desea deshabilitar el plan de&lt;br&gt;credito? 1.Si/2.No: &quot;, 1, 2)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="516" y="34133" width="426" height="56" as="geometry"/></mxCell><mxCell id="n_f15_CB" value="conf == 1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="644" y="34259" width="170" height="80" as="geometry"/></mxCell><mxCell id="n_f15_CC" value="estado[indice] = 1;&lt;br&gt;int cupoNuevo = cupoDisponible(demanda, estado, contPlanes, -1);" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="34417" width="452" height="56" as="geometry"/></mxCell><mxCell id="n_f15_CD" value="printf(&quot;El plan de credito con el ID: %d (%s) esta&lt;br&gt;deshabilitado\n\n&quot;, id[indice], nombres[indice])&lt;br&gt;printf(&quot;Se liberaron %d creditos del cupo mensual\n\n&quot;,&lt;br&gt;demanda[indice])&lt;br&gt;printf(&quot;El asesor, analista, abogado y gestor solo pueden&lt;br&gt;realizar %d creditos mas\n\n&quot;, cupoNuevo)&lt;br&gt;printf(&quot;Para volver a habilitar este plan se necesitan %d&lt;br&gt;creditos libres en el cupo\n\n&quot;, demanda[indice])" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="579" y="34551" width="446" height="152" as="geometry"/></mxCell><mxCell id="n_f15_DA" value="int cupo = cupoDisponible(demanda, estado, contPlanes, -1)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1027" y="34139" width="413" height="44" as="geometry"/></mxCell><mxCell id="n_f15_DB" value="demanda[indice] &amp;gt; cupo" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1107" y="34259" width="252" height="80" as="geometry"/></mxCell><mxCell id="n_f15_DC" value="printf(&quot;Ya no se pueden realizar mas creditos\n&quot;)&lt;br&gt;printf(&quot;(el plan necesita %d creditos y el cupo disponible es&lt;br&gt;%d)\n\n&quot;, demanda[indice], cupo &amp;lt; 0 ? 0 : cupo)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="752" y="34409" width="473" height="72" as="geometry"/></mxCell><mxCell id="n_f15_DD" value