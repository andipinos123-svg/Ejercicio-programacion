 es el nombre del plan de credito? &quot;,&lt;br&gt;nombres[*contPlanes], 50, activos, nActivos, -1)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="513" y="16992" width="413" height="56" as="geometry"/></mxCell><mxCell id="n_f11_O" value="int d = leerDemanda(&quot;\nCuantas solicitudes de credito se reciben&lt;br&gt;al mes? &quot;, demanda, estado, *contPlanes, -1)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="494" y="17130" width="452" height="56" as="geometry"/></mxCell><mxCell id="n_f11_P" value="d == -1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="525" y="17256" width="170" height="80" as="geometry"/></mxCell><mxCell id="n_f11_Q" value="demanda[*contPlanes] = d" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="415" y="17406" width="188" height="44" as="geometry"/></mxCell><mxCell id="n_f11_R" value="tiempo[*contPlanes] = validarFloatRango(&quot;Cuantas horas toma la&lt;br&gt;aprobacion y entrega de un credito? (0.01 a 1000): &quot;, 0.01,&lt;br&gt;1000)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="17520" width="439" height="72" as="geometry"/></mxCell><mxCell id="n_f11_S" value="printf(&quot;\nRecursos del plan de credito: capital, asesor,&lt;br&gt;analista, abogado, gestor&quot;)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="289" y="17662" width="440" height="56" as="geometry"/></mxCell><mxCell id="n_f11_T" value="float cap = validarFloatRango(&quot;\nIngrese la cantidad de&lt;br&gt;capital?: &quot;, 0.01, 1000000)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="313" y="17788" width="393" height="56" as="geometry"/></mxCell><mxCell id="n_f11_U" value="cap == (int)cap" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="17914" width="178" height="80" as="geometry"/></mxCell><mxCell id="n_f11_V" value="snprintf(nomRecurso[*contPlanes], 80, &quot;%d capital, 1 asesor, 1&lt;br&gt;analista, 1 abogado, 1 gestor&quot;, (int)cap)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="42" y="18064" width="439" height="56" as="geometry"/></mxCell><mxCell id="n_f11_W" value="snprintf(nomRecurso[*contPlanes], 80, &quot;%.2f capital, 1 asesor, 1&lt;br&gt;analista, 1 abogado, 1 gestor&quot;, cap)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="531" y="18064" width="452" height="56" as="geometry"/></mxCell><mxCell id="n_f11_X" value="leerNombre(&quot;\nConcesionario donde se realizara la compra? &quot;,&lt;br&gt;concesionario[*contPlanes], 50)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="296" y="18190" width="426" height="56" as="geometry"/></mxCell><mxCell id="n_f11_Y" value="int op = validarEnteroRango(&quot;\nContrato la aseguradora?&lt;br&gt;1.Si/2.No: &quot;, 1, 2)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="313" y="18316" width="393" height="56" as="geometry"/></mxCell><mxCell id="n_f11_Y2" value="op == 1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="424" y="18442" width="170" height="80" as="geometry"/></mxCell><mxCell id="n_f