ibles\n\n&quot;)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="14376" width="420" height="56" as="geometry"/></mxCell><mxCell id="n_f10_E" value="return -1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="190" y="14502" width="120" height="44" as="geometry"/></mxCell><mxCell id="n_f10_F" value="char texto[150];" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="518" y="14382" width="136" height="44" as="geometry"/></mxCell><mxCell id="n_f10_G" value="snprintf(texto, sizeof(texto), &quot;%s(hasta %d): &quot;, pregunta, cupo)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="14502" width="452" height="44" as="geometry"/></mxCell><mxCell id="n_f10_H" value="int valor;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="521" y="14616" width="130" height="44" as="geometry"/></mxCell><mxCell id="n_f10_I" value="valor = validarEnteroRango(texto, 1, 100000)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="426" y="14730" width="320" height="44" as="geometry"/></mxCell><mxCell id="n_f10_J" value="valor &amp;gt; cupo" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="501" y="14844" width="170" height="80" as="geometry"/></mxCell><mxCell id="n_f10_K" value="printf(&quot;Ya no se pueden realizar mas creditos\n&quot;)&lt;br&gt;printf(&quot;(cupo disponible: %d %s)\n\n&quot;, cupo, cupo == 1 ?&lt;br&gt;&quot;credito&quot; : &quot;creditos&quot;)" style="shape=para