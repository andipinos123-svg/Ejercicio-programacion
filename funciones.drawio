*tiempo, int *demanda, int *estado, int&lt;br&gt;*contPlanes, char concesionario[][50], char aseguradora[][50],&lt;br&gt;int *plazo, char cliente[][50], char celular[][11], char&lt;br&gt;cedula[][14], char correo[][60])" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="288" y="15876" width="456" height="104" as="geometry"/></mxCell><mxCell id="n_f11_B" value="*contPlanes &amp;gt;= 10" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="416" y="16050" width="200" height="80" as="geometry"/></mxCell><mxCell id="n_f11_C" value="printf(&quot;Error: ya se registraron los %d planes de credito\n\n&quot;,&lt;br&gt;10)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="16212" width="486" height="56" as="geometry"/></mxCell><mxCell id="n_f11_Z" value="return" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="449" y="19624" width="120" height="44" as="geometry"/></mxCell><mxCell id="n_f11_D" value="cupoDisponible(demanda, estado,&lt;br&gt;*contPlanes, -1) &amp;lt;= 0" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="576" y="16200" width="347" height="80" as="geometry"/></mxCell><mxCell id="n_f11_E" value="printf(&quot;No se puede ingresar otro, ya no hay creditos&lt;br&gt;disponibles\n\n&quot;)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="73" y="16350" width="420" height="56" as="geometry"/></mxCell><mxCell id="n_f11_F" value="printf(&quot;Ingrese el plan de credito %d\n\n&quot;, *contPlanes)" sty