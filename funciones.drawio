="173" y="35877" width="170" height="80" as="geometry"/></mxCell><mxCell id="n_f16_F" value="float capPlan = 0;&lt;br&gt;sscanf(nomRecurso[i], &quot;%f&quot;, &amp;amp;capPlan);&lt;br&gt;tiempoTotal += tiempo[i] * demanda[i];&lt;br&gt;capitalTotal += capPlan * demanda[i];&lt;br&gt;creditosTotal += demanda[i];&lt;br&gt;activos++;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="36075" width="281" height="120" as="geometry"/></mxCell><mxCell id="n_f16_G" value="i++" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="36327" width="130" height="44" as="geometry"/></mxCell><mxCell id="n_f16_H" value="activos == 0" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="808" y="35877" width="170" height="80" as="geometry"/></mxCell><mxCell id="n_f16_I" value="printf(&quot;Error: no hay planes de credito activos&lt;br&gt;registrados\n\n&quot;)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="472" y="36107" width="380" height="56" as="geometry"/></mxCell><mxCell id="n_f16_Z" value="return" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="756" y="38145" width="120" height="44" as="geometry"/></mxCell><mxCell id="n_f16_J" value="tiempoDisp = validarFloatRango(&quot;Ingrese el tiempo disponible&lt;br&gt;(horas): &quot;, 0, 100000000);&lt;br&gt;capitalDisp = validarFloatRango(&quot;Ingrese el capital disponible:&lt;br&gt;&quot;, 0, 1000000000);&lt;br&gt;int hayAsesor = validarEnteroRango(&quot;Hay asesor disponible?&lt;br&gt;1.Si/2.No: &quot;, 1, 2);&lt;br&gt;int hayAnalista = validarEnteroRango(&quot;Hay analista disponible?&lt;br&gt;1.Si/2.No: &quot;, 1, 2);&lt;br&gt;int hayAbogado = validarEnteroRango(&quot;Hay abogado disponible?&lt;br&gt;1.Si/2.No: &quot;, 1, 2);&lt;br&gt;int hayGestor = validarEnteroRango(&quot;Hay gestor disponible?&lt;br&gt;1.Si/2.No: &quot;, 1, 2);" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="902" y="36027" width="446" height="216" as="geometry"/></mxCell><mxCell id="n_f16_K" value="int cumple = (tiempoTotal &amp;lt;= tiempoDisp &amp;amp;&amp;amp; capitalTotal &amp;lt;=&lt;br&gt;capitalDisp &amp;amp;&amp;amp; creditosTotal &amp;lt;= 200 &amp;amp;&amp;amp; hayAsesor == 1 &amp;amp;&amp;amp;&lt;br&gt;hayAnalista == 1 &amp;amp;&amp;amp; hayAbogado == 1 &amp;amp;&amp;amp; hayGestor == 1);" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="36313" width="413" height="72" as="geometry"/></mxCell><mxCell id="n_f16_L" value="printf(&quot;\n&quot; DOBLE)&lt;br&gt;printf(&quot;   EVOLUTH S.A. - EVALUACION DE LA PRODUCCION\n&quot;)&lt;br&gt;printf(&quot;   RESULTADO: %s\n&quot;, cumple ? &quot;PUEDE CUMPLIR con la&lt;br&gt;demanda&quot; : &quot;NO PUEDE CUMPLIR con la demanda&quot;)&lt;br&gt;printf(DOBLE &quot;\n&quot;)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="586" y="36455" width="459" height="104" as="geometry"/></mxCell><mxCell id="n_f16_M" value="mostrarPlanes(id, nombres, nomRecurso, tiempo, demanda, estado,&lt;br&gt;0, 0, contPlanes, concesionario, aseguradora, plazo, cliente,&lt;br&gt;celular, cedula, correo)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="593" y="36629" width="446" height="72" as="geometry"/></mxCell><mxCell id="n_f16_N" value="float diferenciaT = tiempoDisp - tiempoTotal;&lt;br&gt;float diferenciaC = capitalDisp - capitalTotal;&lt;br&gt;char a[40], b[40], c[40];" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="646" y="36771" width="340" height="72" as="geometry"/></mxCell><mxCell id="n_f16_O" value="printf(&quot;\n%-9s %16s %16s %16s  %-8s\n&quot;, &quot;Concepto&quot;, &quot;Requerido&quot;,&lt;br&gt;&quot;Disponible&quot;, &quot;Diferencia&quot;, &quot;Estado&quot;)&lt;br&gt;printf(&quot;------------------------------------------------------------------------\n&quot;)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="504" y="36913" width="624" height="72" as="geometry"/></mxCell><mxCell id="n_f16_P" value="sprintf(a, &quot;%.2f horas&quot;, tiempoTotal);&lt;br&gt;sprintf(b, &quot;%.2f horas&quot;, tiempoDisp);&lt;br&gt;sprintf(c, &quot;%.2f horas&quot;, diferenciaT &amp;lt; 0 ? -diferenciaT :&lt;br&gt;diferenciaT);" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="613" y="37055" width="406" height="88" as="geometry"/></mxCell><mxCell id="n_f16_Q" value="printf(&quot;%-9s %16s %16s %16s  %-8s\n&quot;, &quot;Tiempo&quot;, a, b, c,&lt;br&gt;diferenciaT &amp;gt;= 0 ? &quot;Sobrante&quot; : &quot;Faltante&quot;)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="596" y="37213" width="440" height="56" as="geometry"/></mxCell><mxCell id="n_f16_R" value="sprintf(a, &quot;%.2f&quot;, capitalTotal);&lt;br&gt;sprintf(b, &quot;%.2f&quot;, capitalDisp);&lt;br&gt;sprintf(c, &quot;%.2f&quot;, diferenciaC &amp;lt; 0 ? -diferenciaC :&lt;br&gt;diferenciaC);" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" 